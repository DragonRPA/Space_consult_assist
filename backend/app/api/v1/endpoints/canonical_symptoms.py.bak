                    "criteria_fault": "전선 피복 노출, 레버 파손으로 조향/제어 불가",
                    "fault_action": "즉시 운행 중지 안내 및 긴급 정비 출동 배차"
                }
            ]
        },
        "model_overrides": {
            "J600T": {"part_code": "CHASSIS-LEVER-J600"},
            "J800": {"part_code": "CHASSIS-BUMPER-J800"},
            "S7": {"part_code": "CHASSIS-COVER-S7"},
            "S5": {"part_code": "CHASSIS-SWITCH-S5"},
            "S1": {"part_code": "CHASSIS-HANDLE-S1"},
            "S3": {"part_code": "CHASSIS-LEVER-S3"},
            "쓰담": {"part_code": "CHASSIS-HOOD-SD"}
        }
    }
]


def resolve_symptoms_for_model(model_name: Optional[str] = None) -> List[Dict[str, Any]]:
    """
    선택된 장비 모델에 맞게 표준 16대 장애 유형을 해석하여 반환.
    - model_name이 특정 모델(예: J600T, 쓰담)일 경우, 해당 모델 전용 부품코드 및 세부 단계 기준(step_overrides)이 자동 바인딩됨.
    - model_name이 '전체'이거나 미지정일 경우, 범용 표준 16대 유형 반환.
    """
    target_model = (model_name or "전체").strip()
    
    # 모델명 부분 일치 검색
    matched_model = None
    if target_model != "전체":
        for m in AVAILABLE_MODELS:
            if m != "전체" and (m.lower() in target_model.lower() or target_model.lower() in m.lower()):
                matched_model = m
                break

    resolved_list = []
    for item in CANONICAL_FAILURE_TYPES:
        entry = dict(item)
        action_plan = dict(entry["action_plan"])
        
        # 기본 steps 복사 (깊은 복사)
        steps_copy = [dict(s) for s in action_plan.get("steps", [])]
        
        # 모델별 오버라이드 적용
        if matched_model and "model_overrides" in entry:
            overrides = entry["model_overrides"].get(matched_model)
            if overrides:
                if "part_code" in overrides:
                    entry["part_code"] = overrides["part_code"]
                    action_plan["part_code"] = overrides["part_code"]
                if "call_script" in overrides:
                    action_plan["call_script"] = overrides["call_script"]
                
                # 단계별 수치 오버라이드 (step_overrides)
                if "step_overrides" in overrides:
                    for step_idx, step_data in overrides["step_overrides"].items():
                        for s in steps_copy:
                            if s.get("step_no") == step_idx:
                                s.update(step_data)
        
        action_plan["steps"] = steps_copy
        entry["action_plan"] = action_plan
        resolved_list.append(entry)

    return resolved_list
