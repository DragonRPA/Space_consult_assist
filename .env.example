# ========================================
# Space Advisor — 환경변수 설정
# ========================================

# --- Supabase ---
SUPABASE_URL=https://[프로젝트REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL_MIGRATION=postgresql://postgres:[PW]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.[REF]:[PW]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5

# --- JWT ---
JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- 카카오 알림톡 (CEO 결재 후 활성화) ---
NOTIFICATION_ENABLED=false
ALIGO_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
ALIGO_TPL_COMPLETION=
ALIGO_TPL_VISIT_ACCEPT=

# --- 앱 설정 ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
