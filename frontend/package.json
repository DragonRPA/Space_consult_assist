{
  "name": "space-consult-assist",
  "private": true,
  "scripts": {
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "build": "npm run build:desktop && npm run build:mobile && node build_monorepo.js",
    "purge:vercel": "node ../scripts/auto_purge_vercel.cjs",
    "spec:sync": "node ../scripts/generate_code_file_spec.cjs sync",
    "spec:verify": "node ../scripts/generate_code_file_spec.cjs verify",
    "spec:query": "node ../scripts/generate_code_file_spec.cjs query"
  },
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "lucide-react": "^1.33.0",
    "zustand": "^5.0.15"
  }
}
